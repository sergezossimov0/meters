# Copy to .env and replace every change-me. .env is git-ignored.
# Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=change-me
# At least 32 bytes.
JWT_SECRET=change-me
# Shared HashSHA256 signing key for server and gateways; empty disables signing.
KEY=
# First admin, created at start if both are set (password at least 8 characters).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# TIMEZONE=Asia/Almaty
# LOG_LEVEL=info

# Gateway keys are issued when the admin registers a gateway (L2).
GATEWAY_1_KEY=
GATEWAY_2_KEY=